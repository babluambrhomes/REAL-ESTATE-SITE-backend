// ============================================================
// TABLE: PROPERTY VARIANTS (BHK Configurations)
// ============================================================
// Ek Property (listing) me multiple BHK configurations ho sakti
// hain (2 BHK, 3 BHK, 4 BHK...) aur har config ki price/area/
// floors/inventory/photos alag hoti hai. Is table me har config
// ki apni specs rehti hai.
//
// - price = selling price ya rent/month
// - mrpPrice = strike-through price (discount "13% OFF" dikhane ke liye)
// - furnishingItems = rental unit ki fixtures list [{item, count}]
// - images = per-config gallery
//
// Relations:
//   PropertyVariant Many ←→ 1 Property
// ============================================================

model PropertyVariant {
  id String @id @default(uuid()) @db.Uuid

  // --- Link to Property ---
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // --- Configuration Label ---
  // "2 BHK", "3 BHK", "4 BHK", "Studio", "Plot"
  variantName String @map("variant_name")
  variantCode Int    @unique @default(autoincrement()) @map("variant_code")

  // --- Specs ---
  bedrooms  Int?
  bathrooms Int?
  balconies Int?

  // --- Pricing ---
  price        Decimal  @db.Decimal(12, 2) // sale price ya rent/month
  mrpPrice     Decimal? @map("mrp_price") @db.Decimal(12, 2) // strike-through price
  pricePerSqft Decimal? @map("price_per_sqft") @db.Decimal(12, 2)

  // --- Area ---
  totalArea     Decimal @map("total_area") @db.Decimal(12, 2)
  totalAreaUnit String  @map("total_area_unit") // sqft, sqmt, sqyd, hectare, acre

  carpetArea     Decimal? @map("carpet_area") @db.Decimal(12, 2)
  carpetAreaUnit String?  @map("carpet_area_unit")

  superBuiltUpArea     Decimal? @map("super_built_up_area") @db.Decimal(12, 2)
  superBuiltUpAreaUnit String?  @map("super_built_up_area_unit")

  plotArea     Decimal? @map("plot_area") @db.Decimal(12, 2)
  plotAreaUnit String?  @map("plot_area_unit")

  // --- Floor & Availability ---
  floorNumber        Int?                @map("floor_number")
  totalFloors        Int?                @map("total_floors")
  availabilityStatus AvailabilityStatus? @map("availability_status") // READY_TO_MOVE / UNDER_CONSTRUCTION / NEW_LAUNCH
  possessionDate     DateTime?           @map("possession_date") @db.Date
  isAvailable        Boolean             @default(true) @map("is_available")
  inventoryCount     Int                 @default(0) @map("inventory_count") // kitne units is config ke

  // --- Furnishing ---
  furnishingStatus FurnishingStatus? @map("furnishing_status")
  // [{ "item": "AC", "count": 2 }, { "item": "Sofa", "count": 1 }, ...]
  furnishingItems  Json?             @default("[]") @map("furnishing_items") @db.JsonB

  // --- Media (per-config gallery) ---
  images Json? @default("[]") @db.JsonB

  // Brochure PDF link (Download Brochure button ke liye)
  brochure String? @db.Text

  // --- Display ---
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  // --- Timestamps ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([propertyId, variantName])
  @@index([propertyId, isActive])
  @@map("property_variants")
}
