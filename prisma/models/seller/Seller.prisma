// ============================================================
// TABLE 4: SELLER PROFILES
// ============================================================
// SellerProfile = actual SELLING ENTITY (public-facing profile).
// Ye "user" nahi hai — ye wo cheez hai jiske against properties
// list hoti hain aur buyers inquiry karte hain.
//
// Do type ke sellers hain:
//   1. INDIVIDUAL   → userId = <user>, organizationId = NULL
//                     (Monit: "main individually property sell karunga")
//   2. ORGANIZATION → userId = NULL, organizationId = <org>
//                     (Sohan Company ka public profile — Sohan ki nahi!)
//
// KEY SEPARATION: "Sohan" (user) aur "Sohan Company" (org) alag hain.
//   - Sohan ko org banate waqt INDIVIDUAL seller profile NAHI milti
//   - SellerProfile company ki hoti hai, user_id NULL rehta hai
//   - Sohan sirf org ka OWNER member hota hai (members table me role)
//
// Constraints (DB level, CHECK + unique):
//   - 1 user      → max 1 INDIVIDUAL seller profile (userId @unique)
//   - 1 org       → max 1 seller profile       (organizationId @unique)
//   - INDIVIDUAL  → userId NOT NULL, organizationId NULL
//   - ORGANIZATION→ userId NULL, organizationId NOT NULL
//
// Relations:
//   SellerProfile 1 ←→ 1 User        (optional — sirf INDIVIDUAL)
//   SellerProfile 1 ←→ 1 Organization(optional — sirf ORGANIZATION)
// ============================================================

model SellerProfile {
  id String @id @default(uuid()) @db.Uuid

  // --- Link to User ---
  // INDIVIDUAL seller ke liye: kis user ka seller profile hai
  // ORGANIZATION seller ke liye: NULL (profile company ki hai, user ki nahi)
  //
  // @unique ZAROORI HAI but nullable bhi:
  //   - @unique    → 1 user ka max 1 individual seller profile
  //   - nullable   → multiple org profiles NULL user_id rakh sakti hain
  //     (Postgres me NULLs DISTINCT hote hain, to unique allow karta hai)
  // Isse Prisma 1:1 relation bana rehta hai (User.sellerProfile singular)
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Public Reference Code ---
  // URL/profile pe dikhega: "SELL-7F3K2Q"
  // App layer me generate hoga (collision retry ke saath)
  referenceCode String @unique @map("reference_code")

  // --- Public Profile Page URL ---
  // "/seller/abc-builders"
  slug String @unique

  // --- Seller Type ---
  // INDIVIDUAL ya ORGANIZATION
  sellerType SellerType @map("seller_type")

  // --- Organization Link ---
  // INDIVIDUAL seller → NULL
  // ORGANIZATION seller → organization_id (1 org = 1 seller profile)
  //
  // @unique enforce karta hai: ek org ki sirf EK public seller profile ho
  // org banate waqt create hoti hai (owner ke through)
  organizationId String? @unique @map("organization_id") @db.Uuid
  // Cascade: org delete → uski public profile bhi delete
  // (SET NULL nahi, warna CHECK constraint violate ho jayega)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // --- Category ---
  // Seller kya kaam karta hai (Builder, Broker, Consultant...)
  // INDIVIDUAL aur ORGANIZATION dono seller choose karte hain
  categoryId String?        @map("category_id") @db.Uuid
  category   SellerCategory? @relation(fields: [categoryId], references: [id])

  // --- Scalar KYC Data ---
  // Scalar = number (claim), documents table = proof file
  //
  // INDIVIDUAL seller:
  //   panNumber     → individual's PAN
  //   aadhaarNumber → individual's Aadhaar
  //   reraNumber    → individual's RERA registration
  //
  // ORGANIZATION seller:
  //   reraNumber    → COMPANY ka RERA number (public page pe legally
  //                    display karna mandatory hai)
  //   panNumber     → company ka PAN organizations.panNumber pe hai
  //   aadhaarNumber → NULL (company ka Aadhaar hota hi nahi)
  //
  // Public API me PAN/Aadhaar hamesha masked return karo.
  panNumber     String? @map("pan_number")
  aadhaarNumber String? @map("aadhaar_number")
  reraNumber    String? @map("rera_number")

  // --- Public Profile (Market Standard) ---
  // Buyer ko seller ke baare me dikhega
  headline        String? // "Licensed Agent - South Delhi"
  about           String? @db.Text
  experienceYears Int?    @map("experience_years")

  // ["residential", "commercial", "plots", ...]
  specializations Json? @default("[]") @db.JsonB
  // ["Hindi", "English", ...]
  languages Json? @default("[]") @db.JsonB

  // --- Branding (Profile Page) ---
  // Seller page ka logo aur cover/banner photo (dono types ke liye canonical)
  logoUrl       String? @map("logo_url")
  coverPhotoUrl String? @map("cover_photo_url")

  // --- Address (Common - dono types) ---
  addressLine String? @map("address_line")
  city        String?
  state       String?
  country     String?
  pincode     String?

  // --- Trust & Engagement ---
  happyClientsCount   Int?    @default(0) @map("happy_clients_count")
  responseTimeMinutes Int?    @map("response_time_minutes") // average response time
  isAvailable         Boolean @default(true) @map("is_available")
  // {"hours": "10am-7pm", "off_days": ["sunday"], "note": "..."}
  availabilityDetails Json? @default("{}") @map("availability_details") @db.JsonB

  // --- Media ---
  // [{ "url": "...", "thumbnailUrl": "...", "title": "..." }]
  // Count = array length (alag count field nahi)
  videos Json? @default("[]") @db.JsonB

  // --- Service Areas & Banks ---
  // Seller kis-kis location me kaam karta hai
  // [{ "city": "Mumbai", "state": "MH", "area": "Andheri", "pincode": "400058", "lat": 19.11, "lng": 72.85 }]
  locations Json? @default("[]") @db.JsonB

  // Kis-kis bank/NBFC ne seller ko loan approval diya hai
  // [{ "bankName": "SBI", "bankLogo": "/uploads/sbi.png", "loanTypes": ["Home Loan"], "notes": "Pre-approved" }]
  bankApprovalList Json? @default("[]") @map("bank_approval_list") @db.JsonB

  // --- Achievements & Social ---
  // ["Best Agent 2025", "1000+ Deals Done", ...]
  achievements Json? @default("[]") @db.JsonB
  // ["facebook", "instagram", "linkedin", ...]
  socialLinks Json? @default("[]") @db.JsonB

  // --- Contact & Lead Preferences ---
  contactPhone        String? @map("contact_phone")
  contactEmail        String? @map("contact_email")
  showContactToBuyers Boolean @default(false) @map("show_contact_to_buyers")
  leadPreferences     Json?   @default("{}") @db.JsonB

  // --- Verification / KYC ---
  // Platform verify karega seller ko
  // Personal KYC (PAN/Aadhaar/RERA) — INDIVIDUAL + ORG dono ke liye
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedByUser     User?              @relation("VerifiedSeller", fields: [verifiedBy], references: [id])

  // ORG company verification (GST/Company Registration...)
  // Sirf ORG sellers ke liye; INDIVIDUAL me NULL
  // SellerProfile pe hi dikhta hai — Organization table query nahi karni padegi
  organizationVerificationStatus VerificationStatus? @map("organization_verification_status")
  organizationVerifiedAt         DateTime?           @map("organization_verified_at")
  organizationVerifiedBy         String?             @map("organization_verified_by") @db.Uuid
  organizationVerifiedByUser     User?               @relation("VerifiedOrgSeller", fields: [organizationVerifiedBy], references: [id])

  // --- Status (lifecycle) ---
  // Soft delete ke liye alag "deleted" boolean ya "deletedAt" NAHI hai.
  // Poora lifecycle ek enum me — drift hone ka koi chance nahi.
  // DELETED = soft delete (row kabhi physically delete nahi hoti)
  sellerStatus SellerStatus @default(ACTIVE) @map("seller_status")

  // --- Timestamps ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===========================================================
  // RELATIONS
  // ===========================================================

  // Seller ke KYC documents
  // SellerProfile 1 ←→ Many VerificationDocuments
  verificationDocuments SellerVerificationDocument[]

  // Seller ko mili ratings/reviews
  // SellerProfile 1 ←→ Many Ratings
  ratings SellerRating[]

  // Seller ki properties
  // NOTE: Relation REMOVED — properties ab SellerProfile se linked NAHI hain.
  // Property.userId (creator) + Property.organizationId se ownership decide hoti hai.
  // Reason: "Sohan" (user) aur "Sohan Company" (org) ko mix na karo —
  // org member ki banayi property userId=member + organizationId=org dono set karti hai.
  //
  // Properties fetch karne ke liye:
  //   INDIVIDUAL seller : properties(user_id = seller.userId, organization_id = NULL)
  //   ORG seller        : properties(organization_id = seller.organizationId)

  // Seller ko followers
  // SellerProfile 1 ←→ Many Follows
  // (INDIVIDUAL seller ke followers; ORGANIZATION seller ke followers Organization pe)
  followers SellerFollow[]

  // Seller apne liye create kiye FAQs
  // SellerProfile 1 ←→ Many FAQs
  faqs SellerFaq[]

  // Seller profile/property form se aaye leads/enquiries
  // SellerProfile 1 ←→ Many LeadForms
  leadForms LeadForm[]

  // Org ki "Interested in this organization?" form se aayi inquiries
  // SellerProfile 1 ←→ Many OrganizationInquiries
  // (attribution link — inquiry mandatory org ko jaati hai, ye optional hai)
  organizationInquiries OrganizationInquiry[]

  // Buyer ki book ki hui site visits
  // SellerProfile 1 ←→ Many SiteVisits
  siteVisits SiteVisit[]

  // Buyers ne directly pooche hue sawaal (inbox)
  // SellerProfile 1 ←→ Many BuyerQuestions
  buyerQuestions BuyerQuestion[]

  // Seller ke blog posts
  // SellerProfile 1 ←→ Many Blog Posts
  blogPosts SellerBlogPost[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([verificationStatus])
  @@index([sellerStatus])
  @@map("seller_profiles")
}
