// ============================================================
// TABLE: SELLER CATEGORIES
// ============================================================
// Seller ki category define karta hai - seller kya kaam karta hai.
// INDIVIDUAL ho ya ORGANIZATION, dono seller apni category
// choose karte hain (SellerProfile.categoryId ke through).
//
// Ye table PLATFORM ADMIN manage karega (Super Admin / Staff)
// Seller sirf SELECT karega apni profile ke liye
//
// Relations:
//   SellerCategory 1 ←→ N SellerProfile
//     "Ek category me multiple sellers ho sakte hain"
// ============================================================

model SellerCategory {
  id String @id @default(uuid()) @db.Uuid

  // --- Category Name ---
  // "Builder", "Broker", "Consultant", etc.
  name String

  // --- Slug ---
  // URL-friendly name for filtering/searching
  // "builder", "property-broker", "home-loan-consultant"
  slug String @unique

  // --- Description ---
  // Category ke baare me detail
  // Admin dashboard me dikhega
  description String?

  // --- Image URL ---
  // UI me category ke saath image dikhane ke liye
  imageUrl String? @map("image_url")

  // --- Status ---
  // Active/Inactive toggle
  // Inactive category select nahi ho sakti naye seller ke liye
  // But purane sellers jo is category me hain unpe koi effect nahi
  isActive Boolean @default(true) @map("is_active")

  // --- Timestamps ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===========================================================
  // RELATIONS
  // ===========================================================

  // Is category me kitne sellers hain
  // SellerCategory 1 ←→ N SellerProfile
  sellerProfiles SellerProfile[]

  @@index([isActive])
  @@map("seller_categories")
}
