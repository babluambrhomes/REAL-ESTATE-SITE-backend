// ============================================================
// TABLE: PROPERTIES
// ============================================================
// Real estate property listing ka main table.
// Listing banane wala user ya organization member property list karta hai,
// buyer search/detail dekh sakta hai.
//
// Ownership: `sellerId` REMOVED. Ab:
//   Property Many ←→ 1 User         (userId = creator, optional on delete)
//   Property Many ←→ 1 Organization (organizationId, optional)
//   Property Many ←→ 1 User         (verifiedBy, optional)
//
// Lifecycle: `isActive`/`isVerified`/`deletedAt` REMOVED.
//   visibility  → listingStatus      (DRAFT/PUBLISHED/PAUSED/EXPIRED/REJECTED/DELETED)
//   verification→ verificationStatus (PENDING/IN_REVIEW/VERIFIED/REJECTED)
//   business    → propertyStatus     (AVAILABLE/SOLD/RENTED/WITHDRAWN)
// ============================================================

model Property {
  id String @id @default(uuid()) @db.Uuid

  propertyCode String @unique  @map("property_code")

  // --- Ownership: userId + organizationId ---
  // NOTE: pehle ek mandatory `sellerId` (SellerProfile FK) tha.
  // Ab ownership do fields se decide hoti hai:
  //
  //   userId         → kisne create ki (creator / individual seller)
  //   organizationId → kis org ke liye hai (optional)
  //
  //   INDIVIDUAL seller (Monit)  → userId = Monit,   organizationId = NULL
  //   ORG member (Amit @ O1)    → userId = Amit,    organizationId = O1
  //   Monit, personal listing   → userId = Monit,   organizationId = NULL
  //
  // "Sohan" (user) aur "Sohan Company" (org) mix nahi hote —
  // organizationId hi wo discriminator hai.
  //
  // onDelete: Restrict — a user who has created properties cannot be hard
  // deleted. This is intentional and consistent with the rest of the model:
  // users are never hard-deleted, they go to UserStatus.DEACTIVATED.
  //
  // Cascade would delete a company's whole portfolio when one employee
  // closed their account; SetNull would require user_id to be nullable,
  // which would allow a property with no known owner at all. Restrict
  // states the real rule — the creator is part of the listing's identity.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("PropertyCreator", fields: [userId], references: [id], onDelete: Restrict)

  // onDelete: Restrict — org ke properties hote hue org delete nahi hoga.
  // Org soft delete hota hai (status DEACTIVATED), hard delete se bachata hai.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // --- Basic Info ---
  title       String
  slug        String  @unique
  description String? @db.Text

  transactionType TransactionType @map("transaction_type")
  propertyType    PropertyType  @default(APARTMENT)  @map("property_type")
  propertyStatus  PropertyStatus  @default(AVAILABLE) @map("property_status")

  // --- Location ---
  addressLine   String?  @map("address_line")
  city          String?
  state         String?
  country       String?
  pincode       String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  googleMapLink String?  @map("google_map_link")

  // --- Property Specifics ---
  ownershipType OwnershipType? @map("ownership_type")
  listedBy      ListedBy       @default(OWNER) @map("listed_by")

  ageOfProperty Int? @map("age_of_property") // in years

  // --- Amenities ---
  // ["parking", "swimming_pool", "gym", "garden", ...]
  amenities Json? @default("[]") @db.JsonB

  // --- Nearby & Society (shared across all configs) ---
  // Near-by landmarks: ["FNG Expressway", "APEX Multispecialty", ...]
  nearbyPlaces Json? @default("[]") @map("nearby_places") @db.JsonB
  // Society stats: { "towers": 3, "totalUnits": 420, "landAreaAcres": 4.5, "openSpacePercent": 70, "yearsOfTrust": 8 }
  societyInfo  Json? @default("{}") @map("society_info") @db.JsonB

  // --- Media ---
  // [{"url": "...", "isFeatured": true}, ...]
  images         Json?   @default("[]") @map("images") @db.JsonB
  videos         Json @default("[]") @map("videos") @db.JsonB

  // --- Legal & Docs ---
  reraNumber         String? @map("rera_number")
  registrationNumber String? @map("registration_number")
  taxAssessment      String? @map("tax_assessment")
  encumbrance        String? // Encumbrance certificate details

  // --- Contact Info ---
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // --- Metadata ---
  viewsCount    Int      @default(0) @map("views_count")
  likesCount    Int      @default(0) @map("likes_count")
  sharesCount   Int      @default(0) @map("shares_count")
  ratingCount   Int      @default(0) @map("rating_count")
  averageRating Decimal? @map("average_rating") @db.Decimal(3, 2) // 0.00-5.00
  isFeatured    Boolean  @default(false) @map("is_featured")

  // --- Visibility (lifecycle) ---
  // "isActive" boolean + "deletedAt" timestamp dono hata diye gaye —
  // ek enum se replace. Do fields me drift ho sakta tha
  // (isActive=false par deletedAt=null → do alag code paths
  //  do alag answer dete hain).
  //
  // listingStatus = VISIBILITY (DRAFT/PUBLISHED/PAUSED/EXPIRED/REJECTED/DELETED)
  // propertyStatus = BUSINESS REALITY (AVAILABLE/SOLD/RENTED/WITHDRAWN)
  // Ye do alag cheezein hain, isliye do alag fields.
  listingStatus ListingStatus @default(DRAFT) @map("listing_status")

  // --- Verification ---
  // SellerProfile aur Organization me bhi VerificationStatus enum hai —
  // Property me pehle "isVerified" boolean tha, wo inconsistent tha.
  // Ab teeno me same enum. REJECTED bhi available hai.
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  verifiedAt     DateTime? @map("verified_at")
  verifiedBy     String?   @map("verified_by") @db.Uuid
  verifiedByUser User?     @relation("VerifiedProperty", fields: [verifiedBy], references: [id])

  // --- SEO ---
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")

  // --- Search Engine Columns (managed by triggers, not Prisma) ---
  // PostGIS geography point — auto-populated by trg_property_geog trigger
  geog Unsupported("geography")?
  // Full-text search vector — auto-populated by trg_property_search_vector trigger
  searchVector Unsupported("tsvector")?

  // --- Timestamps ---
  // NOTE: `deletedAt` REMOVED. Soft delete ab `listingStatus: DELETED` se
  // hota hai — row kabhi physically delete nahi hoti.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Property pe aaye seller leads/enquiries
  // Property 1 ←→ Many LeadForms
  leadForms LeadForm[]

  // Property ki site visits
  // Property 1 ←→ Many SiteVisits
  siteVisits SiteVisit[]

  // Is property page se pooche hue buyer sawaal
  // Property 1 ←→ Many BuyerQuestions
  buyerQuestions BuyerQuestion[]

  // BHK configurations (2 BHK, 3 BHK, 4 BHK...) alag price/metrics ke saath
  // Property 1 ←→ Many Variants
  variants PropertyVariant[]

  // Property ke common sawaal-jawaab (possession, RERA, maintenance...)
  // Property 1 ←→ Many FAQs
  faqs PropertyFaq[]

  // Kis user ne property like/wishlist ki
  // Property 1 ←→ Many Likes
  likes PropertyLike[]

  // Kisi bhi user ne property ko ratings/comments diye
  // Property 1 ←→ Many Ratings
  ratings PropertyRating[]

  @@index([userId])
  @@index([organizationId])
  @@index([listingStatus])
  @@index([verificationStatus])
  @@index([propertyType])
  @@index([transactionType])
  @@index([propertyStatus])
  @@index([city])
  @@index([state])
  @@index([isFeatured])

  // NOTE: "public search" partial index (created_at DESC, sirf PUBLISHED
  // + AVAILABLE/UNDER_OFFER) SCHEMA me nahi hai — Prisma ke partial index
  // `where` me `in` support nahi hai (sirf equality aur `not`).
  // Wo raw SQL se manage hota hai, migration me dekho:
  //   prisma/migrations/<...>_property_listing_lifecycle/migration.sql

  @@map("properties")
}
