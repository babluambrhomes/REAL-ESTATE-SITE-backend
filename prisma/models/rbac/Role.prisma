// ============================================================
// TABLE 7: ROLES (Dynamic - Users Create Karenge)
// ============================================================
// Ye DYNAMIC hai - Owner/Super Admin new roles create kar sakte hain.
// Role ek TEMPLATE hai permissions ka.
// Jab kisi member ko role assign karo, usko role ki saari
// permissions automatically mil jaati hain.
//
// Two types based on scope:
//   ORGANIZATION roles → Har org ke apne alag roles honge
//     context_id = organization_id
//   PLATFORM roles → Platform ke global roles
//     context_id = NULL
//
// is_system_role = true → Delete/Edit nahi ho sakta (Owner, Super Admin)
// is_default = true → Agar invite me role select na ho to ye lagega
//
// Relations:
//   Role Many ←→ 1 Organization (optional, via context_id)
//   Role 1 ←→ Many RolePermissions
//   Role 1 ←→ Many Members
//   Role Many ←→ 1 User (created_by)
// ============================================================

model Role {
  id String @id @default(uuid()) @db.Uuid

  // --- Scope ---
  scope RoleScope

  // --- Context ---
  // ORGANIZATION scope → context_id = organization_id
  // PLATFORM scope → context_id = NULL
  //
  // Kyun context_id use kiya organization_id nahi?
  // Kyunki ek hi table me ORGANIZATION aur PLATFORM dono roles hain.
  // Platform roles ka koi organization nahi hota, isliye NULL.
  contextId    String?       @map("context_id") @db.Uuid
  organization Organization? @relation(fields: [contextId], references: [id], onDelete: Cascade)

  // --- Role Info ---
  roleName    String  @map("role_name") // "Owner", "Admin", "Agent", "Super Admin"
  description String?

  // --- Flags ---
  // is_system_role: Owner aur Super Admin roles delete/edit nahi ho sakte
  isSystemRole Boolean @default(false) @map("is_system_role")
  // is_default: Agar invite me role select na ho to ye default lagega
  isDefault    Boolean @default(false) @map("is_default")

  // --- Who Created ---
  createdBy     String @map("created_by") @db.Uuid
  createdByUser User   @relation(fields: [createdBy], references: [id])

  // --- Timestamps ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===========================================================
  // RELATIONS
  // ===========================================================

  // Is role me kaunsi permissions hain
  // Role 1 ←→ Many RolePermissions
  rolePermissions RolePermission[]

  // Is role ke kitne members hain
  // Role 1 ←→ Many Members
  members Member[]

  // Is role ke liye kitne invitations bheje gaye
  // Role 1 ←→ Many Invitations
  invitations Invitation[]

  // ===========================================================
  // UNIQUENESS — partial indexes (not raw SQL, see @@unique below)
  // ===========================================================
  // Pehle @@unique([scope, contextId, roleName]) tha.
  // WO GALAT THA platform rows ke liye — Postgres me NULLs DISTINCT
  // hote hain, to UNIQUE(scope, context_id, role_name) do platform
  // roles dono "SUPER_ADMIN" naam rakh sakte the.
  //
  // Isliye do partial uniques:
  //   org rows      → context_id IS NOT NULL me role_name unique
  //   platform rows → context_id IS NULL me role_name unique
  //
  // previewFeatures = ["partialIndexes"] (schema.prisma) chahiye.

  // NOTE: `name:` is deliberately NOT set — Prisma ignores custom names on
  // partial @@unique and derives them from the columns. The database must
  // therefore use exactly:
  //   roles_scope_context_id_role_name_key  (context_id IS NOT NULL)
  //   roles_scope_role_name_key             (context_id IS NULL)
  @@unique([scope, contextId, roleName], where: { contextId: { not: null } })
  @@unique([scope, roleName], where: { contextId: null })

  @@index([contextId])
  @@index([createdBy])
  @@index([scope, roleName])
  @@map("roles")
}
