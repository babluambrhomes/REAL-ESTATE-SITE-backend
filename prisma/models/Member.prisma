// ============================================================
// TABLE 9: MEMBERS (User ko Role Assign Karna)
// ============================================================
// Ye table batata hai ki KAUN KAHAN KAAM karta hai KIS ROLE ke saath.
//
// Ek hi table me do type ke members hain:
//   ORGANIZATION scope → Organization ka member
//     context_id = organization_id
//   PLATFORM scope → Platform ka staff
//     context_id = NULL
//
// Kyun alag tables nahi banaye?
//   - Query simple rehti hai
//   - Ek user ke sab memberships ek jagah milte hain
//   - Code duplication nahi hota
//
// PERMISSION CHECK FLOW:
//   Member → Role → RolePermissions → Permission
//   Ye chain follow hogi permission check karte waqt
//
// Relations:
//   Member Many ←→ 1 User
//   Member Many ←→ 1 Role
//   Member Many ←→ 1 Organization (optional)
// ============================================================

model Member {
  id String @id @default(uuid()) @db.Uuid

  // --- Scope ---
  scope MemberScope

  // --- Context ---
  // ORGANIZATION → context_id = organization_id
  // PLATFORM → context_id = NULL
  contextId    String?       @map("context_id") @db.Uuid
  organization Organization? @relation(fields: [contextId], references: [id], onDelete: Cascade)

  // --- User Link ---
  // Kaun hai ye member
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Role Link ---
  // Kya role hai iska
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  // --- Status ---
  // Soft delete ke liye MemberStatus.REMOVED (row delete nahi hoti —
  // history aur audit trail bache rehte hain).
  status MemberStatus @default(ACTIVE)

  // --- When Joined ---
  joinedAt DateTime @default(now()) @map("joined_at")

  // --- Timestamps ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===========================================================
  // UNIQUENESS — partial indexes (not raw SQL, see @@unique below)
  // ===========================================================
  // Pehle @@unique([scope, contextId, userId]) tha.
  // WO GALAT THA — Postgres me NULLs DISTINCT hote hain, matlab
  // UNIQUE(scope, context_id, user_id) do PLATFORM rows ko allow
  // karta tha kyunki dono ka context_id = NULL hai aur
  // (PLATFORM, NULL, user_5) == (PLATFORM, NULL, user_5) maana
  // jaata hi nahi.
  //
  // Isliye do partial uniques:
  //   org rows      → context_id IS NOT NULL me unique
  //   platform rows → context_id IS NULL me unique
  //
  // previewFeatures = ["partialIndexes"] (schema.prisma) chahiye.
  // Prisma inhe apne schema se manage karta hai, to raw SQL ki tarah
  // schema-vs-DB drift nahi ho sakta.

  // ===========================================================
  // RELATIONS
  // ===========================================================
  // Member ke through is user ko diye gaye leads / site visits /
  // buyer questions (org sellers me manual assignment ke liye).
  // Relation names alag hain kyunki teen alag models hain —
  // Prisma ek hi relation name do baar use nahi kar sakta.
  //
  // Teeno me Member.id reference hota hai (users nahi), kyunki
  // assignment "org ka member" hai, "user" nahi — ek user kisi
  // aur org me bhi ho sakta hai aur assignment us specific
  // org membership se tied hai.

  // Leads is member ko di gayi
  assignedLeads LeadForm[] @relation("LeadAssignee")

  // Site visits is member ko di gayi
  assignedSiteVisits SiteVisit[] @relation("SiteVisitAssignee")

  // Buyer questions is member ko di gaye
  assignedBuyerQuestions BuyerQuestion[] @relation("BuyerQuestionAssignee")

  // Organization interest inquiries is member ko di gayi
  assignedOrganizationInquiries OrganizationInquiry[] @relation("OrganizationInquiryAssignee")

  // NOTE: `name:` is deliberately NOT set on these. Prisma derives index
  // names for partial @@unique from the columns, and ignores a custom
  // name — so the derived names below are what must match the database:
  //   members_scope_context_id_user_id_key  (context_id IS NOT NULL)
  //   members_scope_user_id_key             (context_id IS NULL)
  @@unique([scope, contextId, userId], where: { contextId: { not: null } })
  @@unique([scope, userId], where: { contextId: null })

  @@index([userId])
  @@index([roleId])
  @@index([contextId])
  @@index([scope, userId])
  @@index([status])
  @@map("members")
}
